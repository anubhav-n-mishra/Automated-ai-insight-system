# Insight Engine configuration.
#
# Copy to .env and edit. Every variable is optional in development; the ones
# marked REQUIRED IN PRODUCTION are enforced at startup when
# INSIGHT_ENGINE_ENVIRONMENT=production, so an unsafe deployment fails fast
# instead of running quietly wide open.

# ---------------------------------------------------------------- runtime ----
INSIGHT_ENGINE_ENVIRONMENT=development        # development | staging | production
INSIGHT_ENGINE_LOG_LEVEL=INFO
INSIGHT_ENGINE_LOG_FORMAT=json                # json | text
INSIGHT_ENGINE_HOST=127.0.0.1
INSIGHT_ENGINE_PORT=8000

# REQUIRED IN PRODUCTION. The origin users reach this deployment on. QR codes
# and dashboard share links are built from it; without it they point at
# localhost and are useless the moment they leave this machine.
# INSIGHT_ENGINE_PUBLIC_BASE_URL=https://insights.example.com

# ------------------------------------------------------------ authentication -
# REQUIRED IN PRODUCTION. Comma-separated shared secrets accepted in the
# X-API-Key header. Leaving this empty disables authentication entirely, which
# makes report generation an open compute and LLM-spend proxy.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# INSIGHT_ENGINE_API_KEYS=key-one,key-two

# Browser origins allowed to call the API. Never "*" in production.
# INSIGHT_ENGINE_CORS_ALLOW_ORIGINS=https://app.example.com

# ------------------------------------------------------------------ limits ---
INSIGHT_ENGINE_MAX_UPLOAD_BYTES=67108864      # 64 MB
INSIGHT_ENGINE_MAX_ROWS=5000000
INSIGHT_ENGINE_RATE_LIMIT_REQUESTS=60         # 0 disables
INSIGHT_ENGINE_RATE_LIMIT_WINDOW_SECONDS=60
INSIGHT_ENGINE_WORKER_THREADS=4

# ----------------------------------------------------------------- storage ---
# Generated decks, audio, sessions and staged uploads live here. Mount a volume
# in production; the container filesystem is not durable.
# INSIGHT_ENGINE_DATA_DIR=/var/lib/insight-engine
INSIGHT_ENGINE_SESSION_TTL_HOURS=72
INSIGHT_ENGINE_ARTIFACT_TTL_HOURS=168

# --------------------------------------------------------------- narrative ---
# Entirely optional. With no provider configured the summary is written
# deterministically from the computed figures, which is the right default for
# deployments that cannot send business metrics to a third party.
INSIGHT_ENGINE_LLM_PROVIDER=auto              # auto | gemini | openai | none
# INSIGHT_ENGINE_LLM_MODEL=gemini-2.0-flash
# INSIGHT_ENGINE_GEMINI_API_KEY=
# INSIGHT_ENGINE_OPENAI_API_KEY=
# Any OpenAI-compatible endpoint works: Azure OpenAI, vLLM, Ollama, LiteLLM.
# INSIGHT_ENGINE_OPENAI_BASE_URL=http://vllm.internal:8000/v1
INSIGHT_ENGINE_LLM_TIMEOUT_SECONDS=45
INSIGHT_ENGINE_LLM_MAX_RETRIES=2

# --------------------------------------------------------------- audio -------
# Without a key the dashboard speaks the briefing with the Web Speech API:
# no egress, no per-report cost.
# INSIGHT_ENGINE_MURF_API_KEY=
INSIGHT_ENGINE_MURF_VOICE_ID=en-US-natalie

# ----------------------------------------------- relational source policy ----
# Off by default. An engine that connects wherever a request tells it to is a
# server-side request forgery primitive against everything it can reach.
INSIGHT_ENGINE_ALLOW_REMOTE_SQL=false
# INSIGHT_ENGINE_ALLOWED_SQL_HOSTS=warehouse.internal,replica.internal
INSIGHT_ENGINE_ALLOWED_SQL_DRIVERS=postgresql,mysql,sqlite,mssql
INSIGHT_ENGINE_SQL_STATEMENT_TIMEOUT_SECONDS=60

# -------------------------------------------------------------- telemetry ----
INSIGHT_ENGINE_METRICS_ENABLED=true
INSIGHT_ENGINE_TRACING_ENABLED=false
# INSIGHT_ENGINE_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
INSIGHT_ENGINE_SERVICE_NAME=insight-engine
